{
  "name": "contractor-collab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Contractor · 项目协作、Agent 执行与版本验收",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "start": "npm run workbench",
    "workbench": "npm run build:ui && node --import tsx src/workbench/server.ts",
    "service:feishu": "node --import tsx src/workbench/feishu-ingress-service.ts",
    "service:knowledge": "node --import tsx src/workbench/octop-index-service.ts",
    "runner": "node --import tsx src/workbench/device-client.ts",
    "ledger": "node --import tsx scripts/ledger.mjs",
    "package:runner": "node scripts/package-runner.mjs",
    "package:source": "node scripts/package-source.mjs",
    "audit:upstream": "node --import tsx scripts/audit-upstream.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run build:ui",
    "build:ui": "vite build --config workbench/vite.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.83",
    "@backstage/catalog-model": "1.10.2",
    "@deepseek-ai/cosmokit": "1.9.0",
    "@deepseek-ai/schemastery": "3.19.0",
    "@tanstack/react-query": "5.102.8",
    "antd": "6.7.1",
    "boring-avatars": "2.0.4",
    "casbin": "5.51.1",
    "lucide-react": "1.48.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tsx": "4.23.15",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ant-design/static-style-extract": "2.1.0",
    "@figma/rest-api-spec": "0.47.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "overrides": {
    "@anthropic-ai/sandbox-runtime": {
      "zod": "$zod"
    }
  },
  "license": "MIT"
}
