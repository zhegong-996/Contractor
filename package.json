{
  "name": "suitme-collab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SuitMe 协作台：Paperclip control plane with upstream source and CLI adapters",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "setup": "node --import tsx scripts/setup.ts",
    "setup:workspaces": "node --import tsx scripts/setup-workspaces.ts",
    "setup:assistant": "node --import tsx scripts/setup-assistant.ts",
    "install:workspaces": "node --import tsx scripts/install-workspace-plugin.ts",
    "build:workspaces": "node --import tsx scripts/install-workspace-plugin.ts --build-only && tsc --noEmit -p plugins/knowledge-workspaces/tsconfig.json",
    "build:chinese-shell": "node --import tsx scripts/build-chinese-shell.ts",
    "setup:graph": "node --import tsx scripts/setup-graph.ts",
    "cognee:native": "node --import tsx scripts/cognee-native.ts",
    "test:cross-role": "node --import tsx scripts/smoke-cross-role.ts --run",
    "install:upstream": "node --import tsx scripts/install-upstream.ts",
    "install:wiki": "node --import tsx scripts/install-wiki.ts",
    "paperclip": "node --import tsx scripts/paperclip.ts",
    "up": "node --import tsx scripts/up.ts",
    "restart:bridge": "node --import tsx scripts/up.ts restart-bridge",
    "stop": "node --import tsx scripts/up.ts stop",
    "status": "node --import tsx scripts/up.ts status",
    "start": "node --import tsx src/server.ts",
    "cli": "node --import tsx src/cli.ts",
    "mcp": "node --import tsx src/mcp.ts",
    "doctor": "node --import tsx scripts/doctor.ts",
    "test": "node --import tsx scripts/test.ts",
    "test:responsive": "node --import tsx scripts/responsive-audit.ts",
    "test:walkthrough": "node scripts/workbench-walkthrough.mjs",
    "vision:start": "node --import tsx scripts/vision-server.ts",
    "acceptance:export": "node --import tsx scripts/export-acceptance.ts",
    "audit:upstream": "node --import tsx scripts/audit-upstream.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "org:preview": "node --import tsx scripts/org-mapping.ts preview",
    "org:auth": "node --import tsx scripts/org-auth.ts",
    "org:table": "node --import tsx scripts/org-table.ts",
    "org:apply": "node --import tsx scripts/org-mapping.ts apply",
    "acceptance:list": "node --import tsx scripts/acceptance-report.ts list",
    "acceptance:report": "node --import tsx scripts/acceptance-report.ts report",
    "acceptance:serve": "node --import tsx scripts/acceptance-report.ts serve",
    "acceptance:self-check": "node --import tsx scripts/acceptance-report.ts self-check",
    "delivery:serve": "node --import tsx scripts/delivery-server.ts",
    "delivery:demo": "node --import tsx scripts/delivery-demo.ts"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "classnames": "2.5.1",
    "culori": "4.0.2",
    "d3-force-3d": "3.0.6",
    "esbuild": "0.28.2",
    "react-force-graph-2d": "1.29.2",
    "tsx": "4.23.15",
    "uuid": "13.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@babel/parser": "8.1.0",
    "@types/node": "24.0.0",
    "typescript": "7.0.2"
  }
}
