{
  "name": "suitme-collab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SuitMe 协作台 · Super-agent 工单与 AutoLoop 执行",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "start": "npm run workbench",
    "workbench": "node --import tsx src/workbench/server.ts",
    "audit:upstream": "node --import tsx scripts/audit-upstream.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@backstage/catalog-model": "1.10.2",
    "casbin": "5.51.1",
    "tsx": "4.23.15",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "typescript": "7.0.2"
  }
}
